{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paluma-trails.example/schema/safety.schema.json",
  "title": "Safety guidance",
  "description": "Plain, offline safety guidance shown beside the map. Facts that change with conditions belong in park alerts, not here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["updated", "intro", "emergency", "sections"],
  "properties": {
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "intro": { "type": "string", "minLength": 1 },
    "emergency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headline", "steps"],
      "properties": {
        "headline": { "type": "string", "minLength": 1 },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "items"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
