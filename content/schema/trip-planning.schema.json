{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paluma-trails.example/schema/trip-planning.schema.json",
  "title": "Offline trip-planning notes",
  "type": "object",
  "additionalProperties": false,
  "required": ["checked", "intro", "sections"],
  "properties": {
    "checked": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "intro": {"type": "string", "minLength": 1},
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "paragraphs", "sources"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "paragraphs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "url"],
              "properties": {
                "label": {"type": "string", "minLength": 1},
                "url": {"type": "string", "format": "uri", "pattern": "^https://"}
              }
            }
          }
        }
      }
    }
  }
}
