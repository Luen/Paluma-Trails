{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paluma-trails.example/schema/manifest.schema.json",
  "title": "Bundle manifest",
  "description": "Generated by tools/paluma_cli. Describes the contents of the offline bundle.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_version", "generator", "files", "totals"],
  "properties": {
    "schema_version": { "type": "integer" },
    "bundle_version": {
      "type": "string",
      "description": "Content-derived version (date + short hash). Changes whenever any file changes."
    },
    "generator": { "type": "string" },
    "park": { "type": "string" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "bytes"],
      "properties": {
        "files": { "type": "integer", "minimum": 0 },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
