{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paluma-trails.example/schema/park.schema.json",
  "title": "Park",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "region", "bounds", "center", "timezone", "updated", "emergency"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "region": { "type": "string", "minLength": 1 },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["north", "south", "east", "west"],
      "properties": {
        "north": { "type": "number", "minimum": -90, "maximum": 90 },
        "south": { "type": "number", "minimum": -90, "maximum": 90 },
        "east": { "type": "number", "minimum": -180, "maximum": 180 },
        "west": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "center": { "$ref": "#/$defs/location" },
    "default_zoom": { "type": "number", "minimum": 1, "maximum": 22 },
    "timezone": { "type": "string" },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "disclaimer": { "type": "string" },
    "emergency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phone", "notes"],
      "properties": {
        "phone": { "type": "string" },
        "alternative_phone": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "attribution": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "licence"],
        "properties": {
          "label": { "type": "string" },
          "url": { "type": "string" },
          "licence": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lat", "lon"],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "elevation_m": { "type": "number" }
      }
    }
  }
}
