{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paluma-trails.example/schema/tracks.schema.json",
  "title": "Tracks",
  "description": "GeoJSON FeatureCollection of track polylines. Coordinates are [lon, lat] per GeoJSON.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "features"],
  "properties": {
    "type": { "const": "FeatureCollection" },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "properties", "geometry"],
        "properties": {
          "type": { "const": "Feature" },
          "properties": { "$ref": "#/$defs/properties" },
          "geometry": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "coordinates"],
            "properties": {
              "type": { "const": "LineString" },
              "coordinates": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "array",
                  "items": { "type": "number" },
                  "minItems": 2,
                  "maxItems": 3,
                  "description": "[lon, lat] or [lon, lat, elevation_m]"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "properties": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "class", "length_m", "source"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "name": { "type": ["string", "null"] },
        "length_m": {
          "type": "integer",
          "minimum": 0,
          "description": "Horizontal length of the polyline in metres."
        },
        "class": {
          "enum": ["track", "walk", "road", "mtb", "connector", "other"],
          "description": "track = maintained walking track, walk = short walk, mtb = mountain bike, connector = link between tracks"
        },
        "maintenance": {
          "enum": ["cleared", "unknown", "overgrown", "closed"]
        },
        "difficulty": { "enum": ["easy", "moderate", "hard", "unknown"] },
        "surface": { "enum": ["formed", "rough", "rocky", "muddy", "mixed", "unknown"] },
        "notes": { "type": ["string", "null"] },
        "unverified": {
          "type": "boolean",
          "description": "Imported but not yet checked against the tracks or the official maps."
        },
        "source": { "type": "string" }
      }
    }
  }
}
